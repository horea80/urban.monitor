# urban.monitor — configurația serverului. Copiază în .env.prod (ignorat de git), ajustează, apoi
# ./deploy/deploy-env.sh o trimite la /opt/urban/.env, de unde o citește unitatea systemd.
# Fără secrete în v1. Toate variabilele au valori implicite în cod; aici sunt cele pentru VPS.

# adresa pe care ascultă serverul; reverse proxy-ul (nginx pe box-ul împrumutat, Caddy pe VPS-ul propriu) trimite aici
IP=127.0.0.1
PORT=8081

URBAN_DATA_DIR=/opt/urban/data
URBAN_START_YEAR=2026
URBAN_REFRESH_DAYS=45
# intervalul sincronizării automate, în ore; 0 = oprită
URBAN_SYNC_HOURS=6
# pauza minimă între cereri către site-ul primăriei (NFR-1)
URBAN_REQUEST_DELAY_MS=1000

RUST_LOG=info
