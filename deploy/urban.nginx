# deploy/urban.nginx → /etc/nginx/sites-available/urban — site-ul urban.monitor pe box-ul cu nginx (ADR-0009).
# Fișierul acoperă doar HTTP; TLS îl adaugă certbot, care rescrie blocul (listen 443 ssl, certificat,
# redirect 80 → 443), după ce DNS-ul arată spre box:
#     sudo certbot --nginx -d urbanism.hopartean.com --redirect
#
# Compresie: nu aici; serverul comprimă singur (tower-http CompressionLayer) după Accept-Encoding, pe care
# nginx îl trimite mai departe neschimbat.

server {
    listen 80;
    listen [::]:80;
    server_name urbanism.hopartean.com;

    access_log /var/log/nginx/urban.access.log;
    error_log  /var/log/nginx/urban.error.log;

    # Aceleași headere ca în urban.caddy; `always` le pune și pe răspunsurile de eroare.
    # 'unsafe-inline': Dioxus injectează scripturi inline pentru hidratare (window.dx_hydrate,
    # initial_dioxus_hydration_data). 'unsafe-eval': interpretorul Dioxus își generează glue-ul JS la rulare cu
    # eval; fără el wasm-ul moare la hidratare și linkurile schimbă URL-ul fără să mai randeze nimic.
    # 'wasm-unsafe-eval': WebAssembly. cdn.jsdelivr.net: Scalar (/api/docs).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data:; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self'; frame-ancestors 'none'" always;
    server_tokens off;

    # Fără add_header în location: în nginx, un add_header într-un bloc interior anulează pe cele moștenite.
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Suprascriem, nu completăm ($proxy_add_x_forwarded_for): serverul limitează rata după primul IP
        # din antet, iar un client ar putea trimite el un X-Forwarded-For fals. nginx e singurul proxy.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
