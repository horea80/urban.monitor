# Înlocuiește domeniul. Caddy obține și reînnoiește certificatul automat.
urban.example.ro {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # 'wasm-unsafe-eval' e necesar pentru WebAssembly. De ajustat după primul deploy
        # dacă hidratarea Dioxus injectează scripturi inline.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
        -Server
    }

    reverse_proxy urban:8080
}
